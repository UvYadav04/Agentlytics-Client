# Copy this file to `.env` (same directory as docker-compose.yml) and fill in real values.
# docker compose auto-loads `.env` next to the compose file for ${VAR} substitution - this is
# NOT the same file as `.env.local` (see .env.local.example), which is only read by `next dev`/
# `next build` when running the app directly on your machine, outside Docker.

# --- Image tagging (Docker Hub) ---
# Your Docker Hub username/org - the image builds and pushes as
# ${DOCKERHUB_USERNAME}/data-analyzer-client.
DOCKERHUB_USERNAME=CHANGEME_your_dockerhub_username
# Which tag to build/pull. Point CI at the exact commit SHA it just built the same way
# Server/.github/workflows/deploy.yml does; leave as `latest` for local dev.
IMAGE_TAG=latest

# --- Build-time only (see docker-compose.yml's top comment for why) ---
# The base API URL the client bundle calls at runtime - point this at api_service's public
# address (e.g. https://your-domain/api), not a compose-internal service name; the browser, not
# another container, is what actually makes these requests.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Leave blank to disable Google sign-in in the built bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
